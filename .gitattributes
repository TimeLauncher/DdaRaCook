# Auto detect text files and perform LF normalization
* text=auto

# ── 셸 스크립트는 LF 고정 ────────────────────────────────
#   text=auto 만 두면 Windows 체크아웃 때 CRLF 가 되고,
#   그러면 bash/WSL 에서 "$'\r': command not found" 로 실패한다.
#   Render(Linux) 배포와 Mac 팀원 양쪽에서 문제가 된다.
*.sh        text eol=lf
gradlew     text eol=lf

# ── Windows 배치 파일은 CRLF 고정 ────────────────────────
*.bat       text eol=crlf
*.cmd       text eol=crlf

# ── 바이너리 — 줄바꿈 정규화 금지 ────────────────────────
*.jpg       binary
*.jpeg      binary
*.png       binary
*.jar       binary
*.keystore  binary
