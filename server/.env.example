# ─────────────────────────────────────────────
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요
#   cp .env.example .env
# .env 는 .gitignore 에 있으므로 커밋되지 않습니다
# ─────────────────────────────────────────────

# 사용할 백엔드: nemotron | openai
VLM_BACKEND=chain

# ── NVIDIA (T0-1에서 확인한 값으로 채울 것) ──
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 실측 확인 완료 (notes/nemotron.md 참조)
#   1순위: nvidia/nemotron-nano-12b-v2-vl            지각 정확, 지연 불안정
#   백업 : nvidia/llama-3.1-nemotron-nano-vl-8b-v1   지연 안정, 지각 약함
#   실격 : meta/llama-3.2-*-vision (다중 이미지 미지원)
NVIDIA_MODEL=nvidia/nemotron-nano-12b-v2-vl

# ── OpenAI (T2-5 조건부, 지금은 비워둬도 됨) ──
OPENAI_API_KEY=
OPENAI_MODEL=

# ── 서버 ──
TEAM_TOKEN=cookassist-dev-change-me
DEBUG_MODE=true

# ── 백업 백엔드 (무료 티어) ──
# NVIDIA NIM 이 간헐적으로 죽습니다(실측 2026-08-26: 21쌍 중 20쌍 실패,
# `EngineCore encountered an issue`). 백업을 두면 그 구간을 넘길 수 있습니다.
# Groq: console.groq.com 에서 무료 발급(카드 불필요). 2026-08 기준 무료 티어에서
#       이미지를 받는 모델은 qwen/qwen3.6-27b 하나입니다.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
# 추론 모델이라 그냥 두면 <think> 로 max_tokens 를 다 써서 JSON 을 못 냅니다.
# none 을 보내야 판정만 출력합니다(실측: 출력 200tok → 16tok).
GROQ_REASONING_EFFORT=none
# Gemini: aistudio.google.com 에서 무료 발급. **주 백엔드입니다.**
# 21쌍 정확도 19/21(90%) · p50 1,737ms · 21회 연속 호출에 429 없음(분당 ~31회).
# gemini-2.x/3.x flash 는 추론 모델이라 CANNOT_TELL 로 잘린다 — flash-lite 를 쓸 것.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── 체인 (폴백 + 헤지) ──
# VLM_BACKEND=chain 으로 켭니다. 맨 앞이 주 백엔드이고 나머지가 백업입니다.
# 주 백엔드가 빨리 답하면 백업은 호출되지 않으므로 무료 한도를 아낍니다.
JUDGE_CHAIN=gemini,groq,nemotron
# 주 백엔드가 이 시간 안에 답하지 않으면 백업을 동시에 발사합니다(헤지).
# ⚠️ 주 백엔드의 정상 응답보다 넉넉히 위, 고장 시간보다는 아래로 잡습니다.
#    낮으면 정상 응답에도 헤지가 나가 백업 무료 한도를 낭비합니다.
#    Gemini 주력 기준: 정상 p50 1.7초 / 관측 최대 2.4초 → 3.0초.
JUDGE_HEDGE_AFTER_S=3.0

# ── 모델 호출 튜닝 (없으면 기본값 사용) ──
# 총 시간 예산(초). 앱 타임아웃 8초보다 짧게 두어 앱이 소켓 타임아웃 대신
# 서버의 503 메시지를 받게 합니다. notes/nemotron.md §8 참조.
VLM_TIMEOUT_S=7.5
# 판정은 JSON 한 줄이면 충분합니다. 크게 잡으면 모델이 수다스러워집니다.
VLM_MAX_TOKENS=200
# VLM 에 보내는 crop 의 긴 변(px). 정확도 측정이 전부 768 기준입니다.
# 앱의 OnDeviceRoiCropper.ROI_OUTPUT_LONG_EDGE 와 반드시 같은 값이어야 합니다.
ROI_OUTPUT_LONG_EDGE=768

# ── YouTube 레시피 추출 (선택) ──
# 클라우드 IP가 YouTube 자막 요청에 차단되면 호스팅 자막 API 키 또는 프록시 중 하나를 설정합니다.
YOUTUBE_TRANSCRIPT_API_KEY=
YOUTUBE_PROXY_URL=
# 텍스트 구조화 전용 기본 모델. 판정용 비전 모델과 분리합니다.
RECIPE_EXTRACTION_MODEL=meta/llama-3.1-8b-instruct
RECIPE_EXTRACTION_TIMEOUT_S=90
RECIPE_EXTRACTION_TIMEOUT_RETRIES=1
RECIPE_EXTRACTION_MAX_TOKENS=4000
